rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function imageUnderLimit() { return request.resource.size < 10 * 1024 * 1024 && request.resource.contentType.matches('image/.*'); }
    function entitlement(uid) { return firestore.get(/databases/(default)/documents/users/$(uid)/entitlements/current).data; }
    function hasEntitlement(uid) { return firestore.exists(/databases/(default)/documents/users/$(uid)/entitlements/current); }
    // Storage Rules permit only two Firestore document accesses. The server
    // mirrors account-reset and retention controls into the entitlement, so
    // upload checks can still reserve the second access for receiptObjects.
    function accountResetReady(uid) {
      let ent = hasEntitlement(uid) ? entitlement(uid) : {};
      return hasEntitlement(uid)
        && 'accountResetStatus' in ent
        && 'accountResetEpoch' in ent
        && 'accountResetEpochString' in ent
        && ent.accountResetStatus == 'complete'
        && ent.accountResetEpoch is int
        && ent.accountResetEpoch >= 0
        && ent.accountResetEpochString is string;
    }
    function accountResetEpoch(uid) {
      let ent = hasEntitlement(uid) ? entitlement(uid) : {};
      return ent.accountResetEpoch;
    }
    function retentionControl(uid) {
      let ent = hasEntitlement(uid) ? entitlement(uid) : {};
      return 'accountRetention' in ent ? ent.accountRetention : {};
    }
    function retentionReady(uid) {
      let control = retentionControl(uid);
      return accountResetReady(uid)
        && 'controlStatus' in control
        && 'lastRetentionEpoch' in control
        && 'lastRetentionEpochString' in control
        && control.controlStatus in ['complete', 'complete_with_warnings']
        && control.lastRetentionEpoch is int
        && control.lastRetentionEpoch >= 0
        && control.lastRetentionEpochString is string
        && !retentionDue(uid);
    }
    function retentionEpochString(uid) { return retentionControl(uid).lastRetentionEpochString; }
    function accountResetEpochString(uid) { return entitlement(uid).accountResetEpochString; }
    function retentionDue(uid) {
      let ent = hasEntitlement(uid) ? entitlement(uid) : {};
      let r = 'accountRetention' in ent ? ent.accountRetention : {};
      return ('purgeRequired' in r && r.purgeRequired == true)
        || ('deleteAfterAt' in r && r.deleteAfterAt is number && r.deleteAfterAt <= request.time.toMillis()
          && !receiptAccess(uid) && !graceReceiptAccess(uid)
          && !('lastDeletionCutoffDate' in r && 'scheduledDeletionDate' in r && r.lastDeletionCutoffDate >= r.scheduledDeletionDate));
    }
    function graceReceiptAccess(uid) {
      let ent = hasEntitlement(uid) ? entitlement(uid) : {};
      return 'lastPaidTier' in ent && ent.lastPaidTier in ['plus','pro'] && 'graceUntil' in ent && ent.graceUntil > request.time.toMillis();
    }
    function receiptEpochReadable(uid) {
      return retentionReady(uid)
        && resource != null
        && resource.metadata != null
        && 'retentionEpoch' in resource.metadata
        && 'accountResetEpoch' in resource.metadata
        && resource.metadata.retentionEpoch == retentionEpochString(uid)
        && resource.metadata.accountResetEpoch == accountResetEpochString(uid);
    }
    function receiptEpochWritable(uid) {
      return retentionReady(uid)
        && request.resource.metadata != null
        && 'retentionEpoch' in request.resource.metadata
        && 'accountResetEpoch' in request.resource.metadata
        && request.resource.metadata.retentionEpoch == retentionEpochString(uid)
        && request.resource.metadata.accountResetEpoch == accountResetEpochString(uid);
    }
    function paidReceiptAccess(uid) {
      let ent = hasEntitlement(uid) ? entitlement(uid) : {};
      let p = 'paidAccess' in ent ? ent.paidAccess : {};
      return ('googlePlayAccess' in ent && ent.googlePlayAccess.active == true && ent.googlePlayAccess.tier in ['plus', 'pro'] && ent.googlePlayAccess.expiresAt > request.time.toMillis())
        || ('appStoreAccess' in ent && ent.appStoreAccess.active == true && ent.appStoreAccess.tier in ['plus', 'pro'] && ent.appStoreAccess.expiresAt > request.time.toMillis())
        || ('proExpiresAt' in p && p.proExpiresAt > request.time.toMillis())
        || ('plusExpiresAt' in p && p.plusExpiresAt > request.time.toMillis())
        || (hasEntitlement(uid) && !('paidAccess' in ent)
        && entitlement(uid).subscriptionStatus in ['active', 'trialing']
        && entitlement(uid).paidTier in ['plus', 'pro']
        && (!('currentPeriodEnd' in entitlement(uid)) || entitlement(uid).currentPeriodEnd > request.time.toMillis()));
    }
    function promotionReceiptAccess(uid) {
      return hasEntitlement(uid)
        && ('promotion' in entitlement(uid))
        && entitlement(uid).promotion != null
        && entitlement(uid).promotion.status == 'active'
        && entitlement(uid).promotion.tier in ['plus', 'pro']
        && (entitlement(uid).promotion.expiresAt == null || entitlement(uid).promotion.expiresAt > request.time.toMillis());
    }
    function projectedPromotionReceiptAccess(uid) {
      return hasEntitlement(uid)
        && ('promotionAccess' in entitlement(uid))
        && (entitlement(uid).promotionAccess.plusPermanent == true
          || entitlement(uid).promotionAccess.plusExpiresAt > request.time.toMillis());
    }
    function receiptAccess(uid) { return paidReceiptAccess(uid) || projectedPromotionReceiptAccess(uid) || promotionReceiptAccess(uid); }
    match /receipts/{uid}/{fileName} {
      allow get: if request.auth != null && request.auth.uid == uid && receiptEpochReadable(uid);
      allow list: if request.auth != null && request.auth.uid == uid && retentionReady(uid);
      // Immutable uploads prevent replacement or metadata edits from bypassing
      // shared-ledger permissions. Cleanup is server mediated for every tier;
      // Free personal deletion remains available through accepted tombstones.
      allow create: if request.auth != null && request.auth.uid == uid && receiptEpochWritable(uid) && receiptAccess(uid) && imageUnderLimit()
        && !firestore.exists(/databases/(default)/documents/receiptObjects/$(uid)/files/$(fileName));
      allow update, delete: if false;
    }
    match /{allPaths=**} { allow read, write: if false; }
  }
}
