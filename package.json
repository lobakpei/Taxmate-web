{
  "name": "taxmate-web",
  "version": "2.1.7",
  "private": true,
  "description": "TaxMate bookkeeping and tax planning web app",
  "scripts": {
    "generate:brand-assets": "node scripts/generate-brand-assets.js",
    "test": "npm run test:characterization && node --test --test-concurrency=1 tests/unit/*.test.js && npm run test:integration && npm run test:rules && npm run test:ltd && npm run test:product-health && npm run test:plan-contract",
    "test:characterization": "node --test tests/characterization/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/programme.test.js tests/integration/healthy-personas.test.js tests/integration/seo-preview.test.js",
    "test:rules": "node --test tests/rules/rules-source.test.js",
    "test:rules:emulator": "node scripts/run-rules-emulator.js",
    "test:functions:emulator": "node scripts/run-functions-emulator.js",
    "test:paid-sync:browser": "node scripts/run-paid-sync-browser.js",
    "test:sync-runtime:browser": "node scripts/run-sync-runtime-browser.js",
    "test:ltd": "node --test tests/facade-contract.test.js tests/v2-corrections.test.js tests/canonical-actions.test.js tests/package-boundary.test.js tests/integrated-contract.test.js tests/ltd-i18n.test.js tests/production-integration-candidate.test.js",
    "test:ltd:browser": "node scripts/run-ltd-preview-browser.js",
    "test:ltd:actual-app": "node scripts/run-ltd-actual-app-browser.js",
    "test:ltd:final-corrections": "node scripts/verify-ltd-final-corrections.js",
    "test:onboarding:connected": "node --test tests/unit/onboarding-connected.test.js && node scripts/run-onboarding-connected-browser.js",
    "preview:onboarding:actual-app": "node scripts/start-onboarding-actual-app-review.js",
    "preview:ltd:actual-app": "node scripts/start-ltd-actual-app-review.js",
    "preview:ltd": "node ui-preview-harness/server.js --port=41742",
    "test:product-health": "node scripts/product-health-gate.js",
    "test:plan-contract": "node scripts/plan-feature-contract-gate.js",
    "audit:bootstrap": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/bootstrap-audit-review.ps1",
    "test:all": "npm test && npm run test:rules:emulator && npm run test:functions:emulator && npm run test:paid-sync:browser && npm run test:ltd:browser && npm run test:ltd:actual-app",
    "stripe:configure:sandbox": "node scripts/configure-stripe-billing-delta.js",
    "stripe:configure:billing-delta": "node scripts/configure-stripe-billing-delta.js",
    "stripe:smoke:live": "node scripts/smoke-live-checkout-sessions.js",
    "promo:admin": "node scripts/manage-founder-promo.js",
    "test:stripe:sandbox": "node scripts/run-stripe-sandbox-emulator.js",
    "test:stripe:hosted-receipt": "node scripts/run-stripe-sandbox-emulator.js tests/integration/stripe-hosted-receipt.test.js",
    "test:stripe:hosted-lifecycle": "node scripts/run-stripe-sandbox-emulator.js tests/integration/stripe-hosted-lifecycle.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.1.0",
    "firebase-tools": "^15.27.0",
    "jszip": "3.10.1",
    "playwright": "^1.55.0"
  }
}
