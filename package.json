{
  "name": "taxmate-web",
  "version": "2.0.0-rc.1",
  "private": true,
  "description": "TaxMate modernisation and hardening candidate",
  "scripts": {
    "test": "node --test",
    "test:characterization": "node --test tests/characterization/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:integration": "node --test tests/integration/programme.test.js tests/integration/seo-preview.test.js",
    "test:rules": "node --test tests/rules/rules-source.test.js",
    "test:rules:emulator": "node scripts/run-rules-emulator.js",
    "test:functions:emulator": "node scripts/run-functions-emulator.js",
    "test:all": "npm run test:characterization && npm run test:unit && npm run test:integration && npm run test:rules && npm run test:rules:emulator && npm run test:functions:emulator",
    "stripe:configure:sandbox": "node scripts/configure-stripe-billing-delta.js",
    "stripe:configure:billing-delta": "node scripts/configure-stripe-billing-delta.js",
    "promo:admin": "node scripts/manage-founder-promo.js",
    "test:stripe:sandbox": "node scripts/run-stripe-sandbox-emulator.js",
    "test:stripe:hosted-receipt": "node scripts/run-stripe-sandbox-emulator.js tests/integration/stripe-hosted-receipt.test.js",
    "test:stripe:hosted-lifecycle": "node scripts/run-stripe-sandbox-emulator.js tests/integration/stripe-hosted-lifecycle.test.js"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase": "^12.1.0",
    "firebase-tools": "^15.27.0",
    "jszip": "3.10.1"
  }
}
